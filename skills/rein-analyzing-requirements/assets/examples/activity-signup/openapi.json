{
  "openapi": "3.0.3",
  "info": { "title": "activity-service", "version": "1.3.0" },
  "paths": {
    "/admin/activity/save": {
      "post": {
        "summary": "保存活动",
        "operationId": "saveActivity",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivitySaveReq" } } }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultActivitySaveResp" } } } }
        }
      }
    },
    "/admin/activity/signups": {
      "get": {
        "summary": "报名名单",
        "operationId": "listSignups",
        "parameters": [
          { "name": "activity_id", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "活动 id" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 1 }, "description": "第几页，从 1 开始" },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 20 }, "description": "每页条数" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultPageSignupItem" } } } }
        }
      }
    },
    "/activity/detail": {
      "get": {
        "summary": "活动详情",
        "operationId": "getActivityDetail",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "活动 id" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultActivityDetail" } } } }
        }
      }
    },
    "/activity/signup": {
      "post": {
        "summary": "报名",
        "operationId": "signup",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignupReq" } } }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultSignupResp" } } } }
        }
      }
    },
    "/activity/my-signups": {
      "get": {
        "summary": "我的报名",
        "operationId": "listMySignups",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 1 }, "description": "第几页，从 1 开始" },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 20 }, "description": "每页条数" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultPageMySignup" } } } }
        }
      }
    },
    "/activity/signup/cancel": {
      "post": {
        "summary": "取消报名",
        "operationId": "cancelSignup",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelReq" } } }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultVoid" } } } }
        }
      }
    },
    "/activity/waitlist": {
      "post": {
        "summary": "排候补",
        "operationId": "joinWaitlist",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignupReq" } } }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultWaitlistResp" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivitySaveReq": {
        "type": "object",
        "required": ["title", "start_time"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "活动 id，新建时不传" },
          "title": { "type": "string", "description": "活动名称" },
          "start_time": { "type": "string", "description": "活动开始时间，yyyy-MM-dd HH:mm:ss" },
          "need_signup": { "type": "boolean", "description": "要不要报名" },
          "max_quota": { "type": "integer", "format": "int32", "description": "名额，1～9999" },
          "quota": { "type": "integer", "format": "int32", "deprecated": true, "description": "老的名额字段，11-25 以后删，改传 max_quota" },
          "signup_deadline": { "type": "string", "description": "报名截止时间，yyyy-MM-dd HH:mm:ss" }
        }
      },
      "ActivitySaveResp": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "活动 id" }
        }
      },
      "SignupItem": {
        "type": "object",
        "properties": {
          "signup_id": { "type": "integer", "format": "int64", "description": "报名记录 id" },
          "name": { "type": "string", "description": "姓名" },
          "phone": { "type": "string", "description": "手机号" },
          "status": { "type": "integer", "format": "int32", "enum": [1, 2, 3], "description": "1 已报名 2 已取消 3 候补中" },
          "create_time": { "type": "string", "description": "报名时间" }
        }
      },
      "PageSignupItem": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "format": "int64", "description": "总条数" },
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/SignupItem" } }
        }
      },
      "ActivityDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "活动 id" },
          "title": { "type": "string", "description": "活动名称" },
          "start_time": { "type": "string", "description": "活动开始时间" },
          "quota": { "type": "integer", "format": "int32", "deprecated": true, "description": "老的名额字段，11-25 以后删，改读 max_quota" },
          "max_quota": { "type": "integer", "format": "int32", "description": "名额" },
          "need_signup": { "type": "boolean", "description": "要不要报名" },
          "remain_quota": { "type": "integer", "format": "int32", "description": "剩余名额，最小是 0" },
          "signup_deadline": { "type": "string", "description": "报名截止时间" },
          "my_status": { "type": "integer", "format": "int32", "nullable": true, "enum": [0, 1, 2, 3], "description": "我的报名状态：0 没报 1 已报名 2 已取消 3 候补中；没登录时为 null" }
        }
      },
      "SignupReq": {
        "type": "object",
        "required": ["activity_id", "name", "phone"],
        "properties": {
          "activity_id": { "type": "integer", "format": "int64", "description": "活动 id" },
          "name": { "type": "string", "maxLength": 20, "description": "姓名" },
          "phone": { "type": "string", "description": "手机号" }
        }
      },
      "SignupResp": {
        "type": "object",
        "properties": {
          "signup_id": { "type": "integer", "format": "int64", "description": "报名记录 id" },
          "remain_quota": { "type": "integer", "format": "int32", "description": "报名后的剩余名额" }
        }
      },
      "MySignup": {
        "type": "object",
        "properties": {
          "signup_id": { "type": "integer", "format": "int64", "description": "报名记录 id" },
          "activity_id": { "type": "integer", "format": "int64", "description": "活动 id" },
          "activity_title": { "type": "string", "description": "活动名称" },
          "start_time": { "type": "string", "description": "活动开始时间" },
          "status": { "type": "integer", "format": "int32", "enum": [1, 2, 3], "description": "1 已报名 2 已取消 3 候补中" },
          "waitlist_rank": { "type": "integer", "format": "int32", "nullable": true, "description": "候补排第几，只有候补中才有" }
        }
      },
      "PageMySignup": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "format": "int64", "description": "总条数" },
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/MySignup" } }
        }
      },
      "CancelReq": {
        "type": "object",
        "required": ["signup_id"],
        "properties": {
          "signup_id": { "type": "integer", "format": "int64", "description": "报名记录 id" }
        }
      },
      "WaitlistResp": {
        "type": "object",
        "properties": {
          "signup_id": { "type": "integer", "format": "int64", "description": "报名记录 id" },
          "rank": { "type": "integer", "format": "int32", "description": "候补排第几" }
        }
      },
      "ResultActivitySaveResp": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ActivitySaveResp" }
        }
      },
      "ResultPageSignupItem": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/PageSignupItem" }
        }
      },
      "ResultActivityDetail": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ActivityDetail" }
        }
      },
      "ResultSignupResp": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/SignupResp" }
        }
      },
      "ResultPageMySignup": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/PageMySignup" }
        }
      },
      "ResultWaitlistResp": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/WaitlistResp" }
        }
      },
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "成功是 OK，失败是错误码" },
          "msg": { "type": "string" }
        }
      }
    }
  }
}
